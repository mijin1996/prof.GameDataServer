@startuml add-monster-sequence
' POST /monsters — 토큰이 있어야 몬스터를 추가할 수 있다
skinparam shadowing false
autonumber

actor "Unity / PowerShell" as Client
participant "ASP.NET Core\n인증 미들웨어" as Auth
participant MonsterEndpoints
participant MonsterService
participant MonsterRepository
participant SqliteMonsterDataSource
database "game.db\n(monsters)" as DB

Client -> Auth : POST /monsters\nAuthorization: Bearer <토큰>\n{ "name": "드래곤", "hp": 500, ... }
Auth -> Auth : 서명·발급자·대상·만료 검사

alt 토큰이 없음 / 틀림 / 만료
  Auth --> Client : 401 Unauthorized
else 토큰 통과
  Auth -> MonsterEndpoints : 요청 + 토큰 주인(sub = "kim")
  MonsterEndpoints -> MonsterService : AddAsync(MonsterDto)

  alt 이름이 비어 있음
    MonsterService --> MonsterEndpoints : Failure(InvalidName)
    MonsterEndpoints --> Client : 400 Bad Request
  else 이름이 있음
    MonsterService -> MonsterRepository : AddAsync(Monster)
    MonsterRepository -> SqliteMonsterDataSource : InsertAsync(MonsterDto)
    SqliteMonsterDataSource -> DB : INSERT INTO monsters ...
    DB --> SqliteMonsterDataSource : 새 id
    SqliteMonsterDataSource --> MonsterRepository : 새 id
    MonsterRepository --> MonsterService : Monster (새 id)
    MonsterService --> MonsterEndpoints : Success(Monster)
    MonsterEndpoints -> MonsterEndpoints : 로그 "몬스터 추가: 드래곤 (추가한 사람: kim)"
    MonsterEndpoints --> Client : 201 Created
  end
end
@enduml
